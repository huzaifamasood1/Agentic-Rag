# Copy this file to .env. Never commit .env.
# The OpenAI key is only used for: the evaluation judge, image descriptions (vision) and,
# if EMBEDDING_PROVIDER=openai, embeddings. Answering runs locally on Ollama.
OPENAI_API_KEY=your_key_here

# Chat model (local, via Ollama) and embeddings (local MiniLM)
CHAT_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=local
# JUDGE_MODEL=gpt-4o-mini   # OpenAI model that grades answers in evaluate.py
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVER_K=4
